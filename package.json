{
  "name": "banan-sha-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "八男杀 网页单机 Demo —— 第一阶段交付（M0-M4）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node scripts/serve.mjs",
    "gen:deck": "node scripts/gen-deck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --experimental-strip-types scripts/simulate.mjs",
    "sim:replay": "node --experimental-strip-types scripts/simulate.mjs 200 --replay"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
